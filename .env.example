# Copy to .env (gitignored) and fill in. Never commit .env and never paste keys into chats.

# Claude API key from Premiere's own Console workspace (the one with the monthly spend limit).
# Deliberately not named ANTHROPIC_API_KEY, so no tool picks it up from the environment by accident.
# Never export it in your shell: Claude Code would then bill the API key instead of the subscription.
PREMIERE_ANTHROPIC_API_KEY=

# Planner: claude (default), mock (saved plans in worker/fixtures/plans) or fallback (no AI, $0)
PLANNER=
# Model alias or id: haiku, sonnet or opus. Defaults to opus (picked after the 6 Nov bake-off).
PLANNER_MODEL=
# Effort: low (default), medium or high
PLANNER_EFFORT=
# App-side monthly cap in USD. Once reached, the planner switches to the no-AI fallback.
# Keep it at or below the Console workspace spend limit. Defaults to 5.
PLANNER_MONTHLY_BUDGET_USD=

# Deepgram key for the narration voice (Aura-2 text to speech, nova-3 for word timings).
# Required for trailers until the Kokoro fallback voice is built: without it a job stops after the storyboard.
DEEPGRAM_KEY=

# Free trailers (worker). Trailers are free for everyone until Vibeathon 02 ends, within the daily
# limits below. Entrant codes are an emergency lever: set CODE or CODE:max_uses, comma separated
# (EXAMPLECODE:200), and the box office asks for one. Leave empty to keep access open.
ACCESS_CODES=
# Trailers per visitor per day (default 5), and for everyone per day (default 80 with codes, 200 without).
ACCESS_PER_VISITOR_DAILY=
ACCESS_DAILY_CAP=

# Payments in USDC through x402 (worker). off (default: everything free), testnet (Base Sepolia,
# settled free by x402.org) or mainnet (Base, settled by PayAI without an API key).
# Check the setup with npm run payments. Nothing here is a secret: only a receiving address.
PAYMENTS=
# The wallet that receives USDC. A public address only; never put a private key or seed phrase anywhere.
PAYMENT_ADDRESS=
# Price per trailer in US dollars of USDC (default 3). Note that x402 clients refuse payments over
# $1 unless the agent raises its spending cap.
PRICE_USDC=
# Optional: another facilitator URL instead of the network default.
X402_FACILITATOR_URL=
# Where the site is served, for links in API responses (default http://localhost:3000).
PUBLIC_URL=

# Optional: where the worker keeps captures, the plan cache and the spend ledger (default worker/.data)
PREMIERE_DATA_DIR=

# Worker job server (npm run serve in worker/). Defaults: 127.0.0.1:8787, no token.
# Set WORKER_TOKEN before the worker listens beyond localhost, and give the web app the same value.
WORKER_HOST=
WORKER_PORT=
WORKER_TOKEN=
# Jobs that run at once (default 1, at most 4). 2 suits a server with 8 or more cores: one job can
# film while another renders. Each running job drives its own browser.
JOB_CONCURRENCY=

# Web app (Next.js reads web/.env.local, or the Vercel project settings): where to reach the worker.
# WORKER_URL=http://127.0.0.1:8787
# WORKER_TOKEN=
# The site's public address, for link previews on X and Discord. Optional on Vercel, which
# supplies the production domain; elsewhere previews use the host each request came in on.
# SITE_URL=https://yourdomain.xyz
