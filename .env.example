# Copy to .env (gitignored) and fill in. Never commit .env and never paste keys into chats.

# Claude API key from Premiere's own Console workspace (the one with the monthly spend limit).
# Deliberately not named ANTHROPIC_API_KEY, so no tool picks it up from the environment by accident.
# Never export it in your shell: Claude Code would then bill the API key instead of the subscription.
PREMIERE_ANTHROPIC_API_KEY=

# Planner: claude (default), mock (saved plans in worker/fixtures/plans) or fallback (no AI, $0)
PLANNER=
# Model alias or id: haiku, sonnet or opus. Defaults to sonnet (picked by the 6 Nov bake-off).
PLANNER_MODEL=
# Effort: low (default), medium or high
PLANNER_EFFORT=
# App-side monthly cap in USD. Once reached, the planner switches to the no-AI fallback.
# Keep it at or below the Console workspace spend limit. Defaults to 5.
PLANNER_MONTHLY_BUDGET_USD=

# Deepgram key for the narration voice (Aura-2 text to speech, nova-3 for word timings).
# Required for trailers until the Kokoro fallback voice is built: without it a job stops after the storyboard.
DEEPGRAM_KEY=

# Free trailers (worker). Entrant codes as CODE or CODE:max_uses, comma separated (EXAMPLECODE:200).
# With no codes set, access is open (local development) but the daily limits still apply.
ACCESS_CODES=
# Trailers per visitor per day (default 3), and for everyone per day (default 80 with codes, 200 without).
ACCESS_PER_VISITOR_DAILY=
ACCESS_DAILY_CAP=

# Optional: where the worker keeps captures, the plan cache and the spend ledger (default worker/.data)
PREMIERE_DATA_DIR=

# Worker job server (npm run serve in worker/). Defaults: 127.0.0.1:8787, no token.
# Set WORKER_TOKEN before the worker listens beyond localhost, and give the web app the same value.
WORKER_HOST=
WORKER_PORT=
WORKER_TOKEN=

# Web app (Next.js reads web/.env.local, or the Vercel project settings): where to reach the worker.
# WORKER_URL=http://127.0.0.1:8787
# WORKER_TOKEN=
